# Copiá este archivo a .env.local para desarrollo local, o cargá estas
# mismas variables en el dashboard de Vercel al deployar el playground.
# Todas son públicas (prefijo NEXT_PUBLIC_) porque solo se usan para armar
# links en la UI del playground — no exponen nada sensible.

# Repo del código fuente en GitHub (botón "GitHub" del header y "Ver código" del hero)
NEXT_PUBLIC_REPO_URL=https://github.com/<usuario>/lib-kit-components

# URL pública de este mismo playground una vez deployado en Vercel
NEXT_PUBLIC_DEMO_URL=https://lib-kit-components.vercel.app

# Versión de la librería que se muestra en el footer del playground
NEXT_PUBLIC_LIB_VERSION=0.1.0

# Link de donaciones (GitHub Sponsors, Ko-fi, etc). Opcional: si se omite,
# el botón de donar no se muestra.
NEXT_PUBLIC_DONATE_URL=
